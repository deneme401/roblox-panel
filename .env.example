# Gerçek değerler yalnızca .env.local (git dışı) ve Vercel → Environment Variables içinde.
# Ayrıntı: docs/07-kurulum-ve-deploy.md

# Supabase (Project Settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Transaction pooler (6543) — uygulama bunu kullanır
DATABASE_URL=postgresql://postgres.<ref>:<şifre>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Doğrudan bağlantı (IPv6) — yalnızca migration/cron kurulum scriptleri
DATABASE_URL_DIRECT=postgresql://postgres:<şifre>@db.<ref>.supabase.co:5432/postgres

# Oturum çerezi imzası (rastgele uzun string) ve canlıda ekip şifresi
SESSION_SECRET=
APP_PASSWORD=

# Toplayıcı route'larını koruyan gizli değer (pg_cron bunu Vault'tan okur)
CRON_SECRET=

# Apify (sosyal sinyaller); günlük kalem sayısı (kaynak başına)
APIFY_TOKEN=
SIGNAL_ITEMS=8

# Gemini — öncelik sırasıyla, virgülle ayrılmış (boşsa varsayılan zincir)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
